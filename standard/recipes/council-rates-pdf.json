{
 "id": "council-rates-pdf",
 "match": [
  "^Your rates instalment$"
 ],
 "tier": "document",
 "container": "pdf",
 "defaults": {
  "date": "dmony"
 },
 "furniture": [
  "^DEMO  -  fictional document$",
  "^Rates and charges, one paw",
  "^Fictional document from",
  "Nothing here is advice\\.$",
  "^advice\\.$",
  "^institution\\."
 ],
 "drop_cells": "^DEMO$",
 "values": {
  "issuer_ref": {
   "find": "^(.+)$"
  },
  "subject_ref": {
   "below": "^Assessment number$"
  },
  "bill_date": {
   "below": "^Issue date$",
   "as": "date"
  },
  "due_on": {
   "below": "^Due date$",
   "as": "date"
  },
  "period_start": {
   "below": "^Rating period$",
   "regex": "^(.+?) to ",
   "as": "date"
  },
  "period_end": {
   "below": "^Rating period$",
   "regex": " to (.+)$",
   "as": "date"
  },
  "amount_cents": {
   "below": "^Instalment due$",
   "as": "cents"
  },
  "reference": {
   "find": "^Instalment notice (.+)$"
  }
 },
 "emit": [
  {
   "kind": "bill",
   "from_values": true
  }
 ],
 "version": 1,
 "fingerprints": [
  "fp1:eb8d6924068012a1fc7259ac"
 ]
}
