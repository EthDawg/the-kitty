{
 "id": "kittenhood-statement-html",
 "match": [
  "^Statement of account$"
 ],
 "tier": "document",
 "container": "html",
 "defaults": {
  "date": "dmony"
 },
 "values": {
  "provider_ref": {
   "find": "^Provider: (.+)$"
  },
  "child_ref": {
   "find": "^Child: (.+)$"
  },
  "period_start": {
   "right": "^Period start$",
   "as": "date"
  },
  "period_end": {
   "right": "^Period end$",
   "as": "date"
  },
  "gross_fee_cents": {
   "right": "^Gross fee$",
   "as": "cents"
  },
  "subsidy_cents": {
   "right": "^Child Care Subsidy$",
   "as": "cents",
   "abs": true
  },
  "gap_cents": {
   "right": "^Gap you pay$",
   "as": "cents"
  }
 },
 "emit": [
  {
   "kind": "childcare_statement",
   "from_values": true
  }
 ],
 "controls": [
  {
   "law": "equation",
   "kind": "childcare_statement",
   "terms": [
    "+gross_fee_cents",
    "-subsidy_cents",
    "-gap_cents"
   ]
  }
 ],
 "version": 1,
 "fingerprints": [
  "fp1:d996b68d53d882180a03086f"
 ]
}
