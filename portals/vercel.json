{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "test -f estate/vault.json || (cd .. && node standard/world/build.js && node portals/build-vault.js)",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "functions": {
    "api/files.js": { "includeFiles": "estate/**" },
    "api/accounts.js": { "includeFiles": "estate/*.json" },
    "api/export.js": { "includeFiles": "estate/*.json" },
    "api/login.js": { "includeFiles": "estate/*.json" },
    "api/estate.js": { "includeFiles": "estate/**" }
  },
  "rewrites": [
    { "source": "/vault/:path*", "destination": "/api/files?path=:path*" },
    { "source": "/api/:surface(drive|mail)", "destination": "/api/estate?surface=:surface" },
    { "source": "/api/:surface(drive|mail)/:tool", "destination": "/api/estate?surface=:surface&tool=:tool" },
    { "source": "/:brand(westpaw|commbark|amewx|ping|propertymeow|pawroll|purrsure|myguv|purrannuation|hestabby|cedartrade|computerpaw|etreat|coinpurr|rentpurrfect|ratepurr|waterbowl|pawprice|meowtility|bupaw|kittenhood|vicpaws|gmeow|litterbox|tabbytax)", "destination": "/portal" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "same-origin" }] }
  ]
}
